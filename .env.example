# ==== Postgres (pgvector) ====
POSTGRES_USER=argi
POSTGRES_PASSWORD=argi_dev_password
POSTGRES_DB=argi
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Async SQLAlchemy URL used by the backend (host = docker service name "db")
DATABASE_URL=postgresql+asyncpg://argi:argi_dev_password@db:5432/argi

# ==== JWT / Auth ====
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ==== Billing / OTP ====
# mock: local persisted subscription flow; OTP is 1234.
# bdapps: real server-to-server OTP + Subscription API calls.
BILLING_PROVIDER=mock
MOCK_OTP_CODE=1234
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
# Prevent repeated carrier OTP requests from the same account.
OTP_REQUEST_COOLDOWN_SECONDS=60
BDAPPS_BASE_URL=https://developer.bdapps.com
# One provisioned BDApps application per recurring tariff.
# IDs normally start with APP_. Passwords are application API keys—not the
# BDApps account password—and must remain server-only.
BDAPPS_PLUS_APPLICATION_ID=
BDAPPS_PLUS_PASSWORD=
BDAPPS_PLUS_APPLICATION_HASH=
BDAPPS_PRO_APPLICATION_ID=
BDAPPS_PRO_PASSWORD=
BDAPPS_PRO_APPLICATION_HASH=
BDAPPS_TIMEOUT_SECONDS=15

# Legacy single-app fallback. Leave empty on new two-app deployments.
BDAPPS_APPLICATION_ID=
BDAPPS_PASSWORD=
BDAPPS_APPLICATION_HASH=
BDAPPS_PLAN_ID=plus

# ==== LLM: OpenRouter (default chat provider) ====
OPENROUTER_API_KEY=
# gemini-2.5-flash: strongest Bengali/Banglish + reliable tool calling (see docs/PLAN.md D2)
OPENROUTER_MODEL=google/gemini-2.5-flash
# Cheap/fast model for narrow node tasks (intent routing, extraction)
OPENROUTER_MODEL_LITE=google/gemini-2.5-flash-lite
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ==== LLM: OpenAI (embedding model provider) ====
OPENAI_API_KEY=xxxxxxxx
OPENAI_EMBED_MODEL=text-embedding-3-small

# ==== LLM: Ollama (optional secondary provider) ====
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1

# ==== Embeddings for pgvector long-term memory ====
# Providers: "fake" (deterministic, offline, zero-dep) | "ollama"
EMBEDDINGS_PROVIDER=fake
EMBEDDING_DIM=768
OLLAMA_EMBED_MODEL=nomic-embed-text

# ==== Knowledge base (RAG) ====
# Providers: "openrouter" (default — reuses OPENROUTER_API_KEY, routes the
# vendor-prefixed slug below to OpenAI) | "openai" (direct, needs
# OPENAI_API_KEY) | "ollama" | "fake" (offline tests). Dim is baked into the
# pgvector column (migration 0005) — changing model/dim needs a new
# migration + re-ingest.
KB_EMBEDDINGS_PROVIDER=openrouter
KB_EMBED_MODEL=openai/text-embedding-3-small
KB_EMBEDDING_DIM=1536
KB_TOP_K=5
KB_CHUNK_SIZE_CHARS=1800
KB_CHUNK_OVERLAP_CHARS=200

# ==== Agent memory tuning ====
HISTORY_LIMIT=40
MEMORY_TOP_K=5

# ==== Frontend ====
# Browser-visible URL of the backend API.
# docker-compose maps the backend to host port 8080 (container 8000) and
# Postgres to host 5433, to avoid clashing with other local services.
NEXT_PUBLIC_API_URL=http://localhost:8080
